import 'package:flutter/material.dart';

void main() {
  runApp(MyApp());
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    double width = MediaQuery.of(context).size.width;

    // Dashboard items data
    final List<Map<String, dynamic>> dashboardItems = [
      {'icon': Icons.home, 'label': 'Home'},
      {'icon': Icons.info, 'label': 'About Us'},
      {'icon': Icons.contact_mail, 'label': 'Contact Us'},
    ];

    // Builds a single dashboard item (icon + label)
    Widget buildDashboardItem(IconData icon, String label) {
      return Padding(
        padding: const EdgeInsets.all(12.0),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Icon(icon, size: 40, color: Colors.white),
            const SizedBox(height: 8),
            Text(
              label,
              style: const TextStyle(
                fontSize: 16,
                color: Colors.white,
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
        ),
      );
    }

    return MaterialApp(
      debugShowCheckedModeBanner: false,
      home: Scaffold(
        appBar: AppBar(
          title: Text("Responsive UI"),
        ),
        body: Stack(
          children: [
            // Wallpaper covering the entire screen
            Positioned.fill(
              child: Image.network(
                'https://picsum.photos/800/1600',
                fit: BoxFit.cover,
              ),
            ),

            // Foreground content
            Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  width < 600
                      ? Text(
                          "Mobile Screen",
                          style: TextStyle(
                            fontSize: 25,
                            color: Colors.white,
                            fontWeight: FontWeight.bold,
                          ),
                        )
                      : Text(
                          "Large Screen",
                          style: TextStyle(
                            fontSize: 25,
                            color: Colors.white,
                            fontWeight: FontWeight.bold,
                          ),
                        ),

                  const SizedBox(height: 40),

                  // Dashboard: Column for mobile, Row for large screens
                  width < 600
                      ? Column(
                          mainAxisSize: MainAxisSize.min,
                          children: dashboardItems
                              .map((item) => buildDashboardItem(
                                  item['icon'], item['label']))
                              .toList(),
                        )
                      : Row(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: dashboardItems
                              .map((item) => buildDashboardItem(
                                  item['icon'], item['label']))
                              .toList(),
                        ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
